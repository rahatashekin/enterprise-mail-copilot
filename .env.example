# =============================================================
# Enterprise Solutions - Environment Configuration Template
# Copy this to .env and fill in your values
# =============================================================

# Gmail OAuth
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here

# Google Sheet
GOOGLE_SHEET_ID=your_sheet_id_here

# Green-API (WhatsApp)
GREENAPI_ID_INSTANCE=your_instance_id
GREENAPI_API_TOKEN=your_api_token
GREENAPI_HOST=https://xxxx.api.greenapi.com

# Phone Numbers
RECIPIENT_PHONE=+880XXXXXXXXXX
TEST_PHONE=+880XXXXXXXXXX
recipient_phone=+880XXXXXXXXXX
